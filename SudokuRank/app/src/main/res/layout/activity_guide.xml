<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnBackGuide"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Luật và Cách chơi"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:text="LUẬT CHƠI"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/sudoku_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• Điền các số từ 1 đến 9 vào bảng.\n\n• Mỗi hàng chỉ được xuất hiện 1 số duy nhất.\n\n• Mỗi cột chỉ được xuất hiện 1 số duy nhất.\n\n• Mỗi ô vuông 3x3 không được trùng số.\n\n• Sai quá 3 lần sẽ thua."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"/>

                <TextView
                    android:text="CÁCH CHƠI"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/sudoku_primary"
                    android:layout_marginTop="24dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Chọn ô trống.\n\n2. Bấm số bên dưới để điền.\n\n3. Có thể bật Ghi chú để ghi số nhỏ.\n\n4. Dùng Gợi ý nếu gặp khó.\n\n5. Hoàn thành toàn bộ bảng để chiến thắng."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>