<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SudokuRank" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sudoku_primary</item>
        <item name="android:statusBarColor">@color/sudoku_primary_dark</item>
    </style>

    <style name="Theme.SudokuRank" parent="Base.Theme.SudokuRank" />

    <style name="CustomDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>